{
  "name": "dhvani",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "mac:assets": "node scripts/build-mac.mjs",
    "mac:build": "node scripts/build-mac.mjs && cd macos && xcodegen && xcodebuild -project Dhvani.xcodeproj -scheme Dhvani -configuration Release -derivedDataPath build build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "potrace": "^2.1.8",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
